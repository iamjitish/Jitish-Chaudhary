<section
    class="vision-gallery"
    data-hotspot-bonus-variant-id="{% if section.settings.bonus_product != blank %}{{ section.settings.bonus_product.selected_or_first_available_variant.id }}{% endif %}"
    data-hotspot-trigger-color="{{ section.settings.trigger_color | escape }}"
    data-hotspot-trigger-size="{{ section.settings.trigger_size | escape }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-locale="{{ request.locale.iso_code }}"
>

    <div class="page-width">

        {% if section.settings.heading != blank %}
            <div class="vision-gallery__header">
                <h2>{{ section.settings.heading }}</h2>
            </div>
        {% endif %}

        <div class="vision-gallery__grid">
            {% for block in section.blocks %}
                {% assign product = block.settings.product %}
                <div class="vision-gallery__item" {{ block.shopify_attributes }}>
                    {% if block.settings.image != blank %}
                        {% assign grid_image_alt = block.settings.image.alt | default: product.title | default: 'Product in lifestyle photo' %}
                        {{
                            block.settings.image
                            | image_url: width: 900
                            | image_tag:
                                loading: 'lazy',
                                class: 'vision-gallery__image',
                                alt: grid_image_alt
                        }}
                    {% endif %}
                    {% if product != blank %}
                        <button
                            class="vision-gallery__hotspot"
                            type="button"
                            data-handle="{{ product.handle }}"
                            style="
                                top:{{ block.settings.top }}%;
                                left:{{ block.settings.left }}%;
                            "
                        >
                            +
                        </button>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- QUICK SHOP POPUP -->
    <div class="vision-popup">
        <div class="vision-popup__overlay"></div>
        <div class="vision-popup__wrapper">
            <button
                class="vision-popup__close"
                type="button"
                aria-label="Close"
            >
                &times;
            </button>

            <div class="vision-popup__left">
                <img src="" alt="" class="popup-image">
            </div>

            <div class="vision-popup__right">
                <h3 class="popup-title"></h3>
                <div class="popup-price"></div>
                <div class="popup-description"></div>
            </div>

            <!-- Color -->
            <div class="popup-group popup-group--color">
                <label class="popup-label">Color</label>
                <div class="popup-colors"></div>
            </div>

            <!-- Size -->
            <div class="popup-group popup-group--size">
                <label class="popup-label">Size</label>

                <div class="popup-select">
                    <select class="popup-size">
                    </select>

                    <svg width="15" height="9" viewBox="0 0 15 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1.06067 1.06067L7.06067 7.06067L13.0607 1.06067" stroke="black" stroke-width="1.5" stroke-linecap="square"/>
                    </svg>
                </div>
            </div>

            <button class="popup-cart" type="button">
                <span>ADD TO CART</span>
                <svg width="36" height="12" viewBox="0 0 36 12" fill="none">
                    <path d="M1 6H32" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M27 1L34 6L27 11" stroke="currentColor" stroke-width="1.5"/>
                </svg>
            </button>
            <div class="popup-cart-message"></div>
        </div>

    </div>

</section>

{% schema %}
{
  "name": "Hotspot Product",
  "tag": "section",
  "class": "hotspot-product-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    },
    {
      "type": "header",
      "content": "Auto-add to cart (Black + Medium)"
    },
    {
      "type": "product",
      "id": "bonus_product",
      "label": "Bonus product",
      "info": "When the customer adds a variant with the color and size below, this product is added automatically (e.g. Soft Winter Jacket)."
    },
    {
      "type": "text",
      "id": "trigger_color",
      "label": "Trigger color",
      "default": "Black"
    },
    {
      "type": "text",
      "id": "trigger_size",
      "label": "Trigger size",
      "default": "M",
      "info": "Enter the size exactly as available (e.g. use S, M, L, XL etc)"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "header",
          "content": "Grid photo and linked product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lifestyle / grid image",
          "info": "Upload the photo shown in the grid (e.g. model wearing the item). Separate from the product catalog image used in the popup."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Hotspot opens a popup with this product’s name, price, description, image, and variants."
        },
        {
          "type": "header",
          "content": "Hotspot position on the image"
        },
        {
          "type": "range",
          "id": "top",
          "label": "Hotspot top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "left",
          "label": "Hotspot left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hotspot Product",
      "blocks": [
        { "type": "hotspot" },
        { "type": "hotspot" },
        { "type": "hotspot" },
        { "type": "hotspot" },
        { "type": "hotspot" },
        { "type": "hotspot" }
      ]
    }
  ]
}
{% endschema %}