<div>
  {% if section.settings.bg_image != blank or section.settings.bg_image_mobile != blank %}
    <div class="gift-guide__background">
      <picture>

        {% if section.settings.bg_image_mobile != blank %}
          <source
            media="(max-width: 767px)"
            srcset="{{ section.settings.bg_image_mobile | image_url: width: 900 }}">
        {% endif %}

        {% if section.settings.bg_image != blank %}
          <img
            src="{{ section.settings.bg_image | image_url: width: 2200 }}"
            alt="{{ section.settings.heading | escape }}"
            class="gift-guide__bg-image"
            loading="lazy"
            width=""
            height="">
        {% elsif section.settings.bg_image_mobile != blank %}
          <img
            src="{{ section.settings.bg_image_mobile | image_url: width: 900 }}"
            alt="{{ section.settings.heading | escape }}"
            class="gift-guide__bg-image"
            loading="lazy"
            width=""
            height="">
        {% endif %}

      </picture>
    </div>
  {% endif %}


</div>

{% schema %}
{
  "name": "Gift Guide",
  "tag": "section",
  "class": "gift-guide",

  "settings":[
  {
    "type": "image_picker",
    "id": "bg_image",
    "label": "Background Image"
  },
  {
  "type": "image_picker",
  "id": "bg_image_mobile",
  "label": "Mobile Background Image"
},
  {
    "type": "text",
    "id": "heading",
    "label": "Heading",
    "default": "The Gift Guide"
  },
  {
    "type": "richtext",
    "id": "description",
    "label": "Description"
  },
  {
  "type": "richtext",
  "id": "mobile_description",
  "label": "Mobile Description"
},
  {
    "type": "text",
    "id": "button_text",
    "label": "Button Text",
    "default": "SHOP NOW"
  },
  {
    "type": "url",
    "id": "button_link",
    "label": "Button Link"
  },
  {
    "type": "checkbox",
    "id": "show_arrow",
    "label": "Show Arrow",
    "default": true
  },
  {
    "type": "text",
    "id": "bottom_text",
    "label": "Bottom Text",
    "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
  },
  {
  "type": "text",
  "id": "mobile_bottom_text",
  "label": "Mobile Bottom Text"
}
],

  "presets": [
    {
      "name": "Gift Guide"
    }
  ]
}
{% endschema %}